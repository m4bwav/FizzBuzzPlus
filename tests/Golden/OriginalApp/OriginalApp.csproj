<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The 2014 console app (FizzBuzzWithOutput), rebuilt from the frozen source in ../Original, unchanged, so the golden
    capture can record what it prints. net48 is the runtime it was written for (it targeted .NET Framework 4.5);
    net10.0 is the same source on today's runtime. The empty Directory.* files in ../ keep the repository's MSBuild
    settings out, so later changes to the repository cannot change what this program does.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>FizzBuzzWithOutput</AssemblyName>
    <RootNamespace>FizzBuzzWithOutput</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Original/FizzBuzzProcessor.cs" Link="Original/FizzBuzzProcessor.cs" />
    <Compile Include="../Original/Program.cs" Link="Original/Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
